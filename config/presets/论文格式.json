{
  "name": "论文格式",
  "description": "符合中文出版规范的默认配置",
  "version": "1.0",
  "page": {
    "paper_size": "A4",
    "orientation": "portrait",
    "margin_top": 1.7,
    "margin_bottom": 2.6,
    "margin_left": 3.7,
    "margin_right": 3.2,
    "gutter": 0.8
  },
  "typography": {
    "body_font_cn": "华文黑体",
    "body_font_en": "Trebuchet MS",
    "body_font_size": 16.5,
    "body_color": "#000000",
    "headings": {
      "h1": {
        "font_cn": "黑体",
        "font_en": "Arial",
        "font_size": 22.0,
        "bold": true,
        "color": "#000000",
        "alignment": "left"
      },
      "h2": {
        "font_cn": "黑体",
        "font_en": "Arial",
        "font_size": 18.0,
        "bold": true,
        "color": "#000000",
        "alignment": "left"
      },
      "h3": {
        "font_cn": "黑体",
        "font_en": "Arial",
        "font_size": 14.0,
        "bold": true,
        "color": "#000000",
        "alignment": "left"
      }
    },
    "line_spacing_mode": "multiple",
    "line_spacing": 1.5,
    "line_spacing_fixed": 20.0,
    "para_space_before": 0.0,
    "para_space_after": 0.0,
    "first_line_indent_chars": 2.0,
    "alignment": "left"
  },
  "content": {
    "list_bullet_char": "●",
    "list_indent": 0.63,
    "blockquote_bar_color": "#CCCCCC",
    "blockquote_bg_color": "#F5F5F5",
    "blockquote_left_indent": 1.3,
    "code_font": "Consolas",
    "code_font_size": 9.0,
    "code_bg_color": "#F4F4F4",
    "code_border": true,
    "table_header_bg": "#D9E2F3",
    "table_border": true,
    "table_border_color": "#000000",
    "image_max_width_pct": 80.0,
    "image_center": true,
    "link_color": "#0563C1",
    "link_underline": true
  },
  "advanced": {
    "heading_numbering": false,
    "heading_numbering_format": "1.",
    "auto_toc": false,
    "toc_depth": 3,
    "header_text": "",
    "footer_text": "",
    "cover_enabled": false,
    "cover_title": "",
    "cover_author": "",
    "cover_date": "",
    "watermark_text": "",
    "watermark_font_size": 72.0,
    "watermark_opacity": 0.1
  }
}